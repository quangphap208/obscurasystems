# ---- Telegram bot ----
BOT_TOKEN=123456:ABC...                 # token bot từ @BotFather
ADMIN_IDS=1144383007                    # tg_id admin (dùng /grant + nhận alert), ngăn cách bằng dấu phẩy
BOT_LABEL=🕶️ Obscura                    # nhãn nút thương hiệu trong tin thông báo
SUPPORT_CONTACT=                        # vd @obscura_support — hiện ở lệnh /support (trống cũng được)

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=redacted_clone

# ---- Pool Bloom (nguồn dữ liệu X) ----
# Mỗi token = 1 shard. Lấy giá trị cookie __Secure-session_token của tài khoản Bloom đã login.
BLOOM_SESSIONS=token_shard_1,token_shard_2
BLOOM_CAPACITY=200                      # số account tối đa 1 shard track (đo/điều chỉnh theo Bloom)
SOURCE_EXCLUSIVE=0                       # 1 = untrack MỌI account ngoài watches (CHỈ khi Bloom dùng RIÊNG cho bot này!)
HEADLESS=1                              # 0 để hiện browser khi debug
WARMUP_MS=12000                         # bỏ qua backlog khi mới connect (tránh spam)
PROFILE_POLL=1                          # 1 = dò đổi avatar/name/verified (feed-driven + poll). 0 = tắt
PROFILE_POLL_MS=120000                  # poll fallback cho account IM LẶNG (ms). Account có tweet = real-time qua feed

# ---- Nguồn j7 (BE thứ 2, chạy song song Bloom) — auth JWT socket, KHÁC Bloom ----
# Bật kol-be-j7 khi có token. Lấy J7_SESSION_TOKEN = localStorage.sessionId sau khi đăng nhập j7tracker.io.
# ⚠️ ĐẶT TOKEN THẬT VÀO .env (gitignore), KHÔNG để ở file .example này (bị commit).
J7_SESSION_TOKEN=                        # JWT sessionId của tài khoản j7 (trống = BE j7 không chạy)
J7_HOST=https://nyc.j7tracker.io        # host socket + /api/session-check
J7_KEEPALIVE_HOURS=6                     # chu kỳ validate + auto-rotate token (0 = tắt)

# ---- Alert / Monitor (tuỳ chọn) ----
SLACK_WEBHOOK=                           # Slack Incoming Webhook — alert lỗi Bloom/j7 (session/FATAL/pool đầy/tracker-sync/feed im lặng). Trống = tắt
FEED_SILENCE_MIN=10                      # báo Slack khi feed IM LẶNG > N phút (WS treo/rớt ngầm). 0 = tắt
MONITOR_CHAT=                            # chat_id channel firehose QC (soi merge 2 BE). Trống = tắt. Xem docs/LOCAL_TEST.md
# MONITOR_ONLY=1                         # (TEST) chỉ bắn monitor channel, BỎ DM user (tránh 400 chat-not-found khi clone DB prod)
# OBSERVE_ONLY=1                         # (TEST) tắt tracker-sync 2 BE — chỉ observe feed, không track/untrack

# ---- Gói cước / thanh toán ----
SUBS_ENABLED=0                          # 0 = TẮT /subscribe (giai đoạn test). Đặt 1 để mở bán Pro
STARS_PROVIDER_TOKEN=                   # để TRỐNG = thanh toán bằng Telegram Stars (XTR)
PRO_PRICE_STARS=500
PRO_DAYS=30
PRO_LIMIT=25
FREE_LIMIT=3

# ---- Seed (tuỳ chọn, cho scripts/seed.mjs) ----
# SEED_USER=1144383007
# SEED_USERNAME=tester
# SEED_WATCH=elonmusk,cz_binance
